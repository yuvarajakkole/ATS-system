# Required: your OpenAI API key
OPENAI_API_KEY=sk-your-key-here

# Verify this against OpenAI's CURRENT model list before relying on it —
# model availability/names change and this was set from training-era knowledge.
# Use a model that supports Structured Outputs (json_schema response_format).
OPENAI_MODEL=gpt-4o-mini

# SQLite file, created automatically on first run
DATABASE_URL=sqlite:///./ats_system.db

# Optional: only needed if you plug in a paid search provider instead of the
# default no-key DuckDuckGo + Wikipedia tools in agents/search_tools.py
SERPAPI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# How old a stored Company Evaluation Profile can be before the agent
# is asked to refresh it (days)
COMPANY_PROFILE_MAX_AGE_DAYS=30
